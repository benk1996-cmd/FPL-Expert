# Copy to `.env` and fill in. `.env` is gitignored; this template is not.
#
# FPL_ENTRY is your manager id — the number in your team URL:
#   fantasy.premierleague.com/entry/1234567/event/1
# `fpl myteam` reads it so the id need not be typed, and the Streamlit My Team tab
# reports on it. A real environment variable overrides this file.
FPL_ENTRY=1234567
